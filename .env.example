NVIDIA_API_KEY=
GREEK_BACKEND=ollama
NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Extra NIM models offered in the sidebar, comma-separated (NIM_MODEL is always first).
NIM_MODELS=
NIM_MAX_TOKENS=2048
NIM_REASONING_EFFORT=low
LEONIDA_MODEL=leonida
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=1h
OLLAMA_CHAT_MODEL=gemma4:e4b
OLLAMA_CHAT_KEEP_ALIVE=5m
# Other Greek-reply assistants (key only from the environment or this file; never commit it).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Extra OpenAI / Gemini models offered in the sidebar, comma-separated (the *_MODEL value is first).
OPENAI_MODELS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODELS=
# Optional faster hosted translator (private OpenAI-style /v1/completions endpoint). Empty = Ollama.
TRANSLATOR_URL=
TRANSLATOR_TOKEN=
